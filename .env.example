# tlk-sentinel — kopyala: cp .env.example .env
TLK_PROFILE=public
TLK_LANG=tr

# Log kaynakları (Linux). Boşsa devre dışı.
TLK_SSHD_LOG=/var/log/auth.log
TLK_NGINX_LOG=/var/log/nginx/access.log

# Güvenlik duvarı: nft | ipset | none. Canlıda DRYRUN=0.
TLK_FW_BACKEND=nft
TLK_FW_DRYRUN=1
TLK_FW_CHAIN=tlk_sentinel

# Bildirim (self). Repoya koyma.
TLK_DISCORD_WEBHOOK=

TLK_ALLOWLIST=127.0.0.1,::1

# self: bütünlüğü izlenecek dosyalar (virgülle)
TLK_INTEGRITY=

# Olay veritabanı + itibar/GeoIP verileri
TLK_DB=./data/sentinel.db
TLK_REPUTATION_DIR=./data/reputation
TLK_COUNTRY_FILE=

# Davranışsal anomali
TLK_ANOMALY=1

# Panel (varsayılan localhost). Dışa açarsan token ZORUNLU.
TLK_PANEL=1
TLK_PANEL_HOST=127.0.0.1
TLK_PANEL_PORT=8787
TLK_PANEL_TOKEN=

# Aktif savunma (self): kaç kritikte kalıcı ban
TLK_ACTIVEDEF_SET=tlk_perma
TLK_ACTIVEDEF_CRITS=2

TLK_SWEEP_MS=30000
