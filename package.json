{
  "name": "tlk-sentinel",
  "private": true,
  "version": "1.0.0",
  "description": "Server and application security engine: log-driven detection, IP banning, reputation and anomaly scoring, live panel",
  "license": "SEE LICENSE IN LICENSE",
  "author": "talkdedsec <talkdedsec@proton.me>",
  "repository": { "type": "git", "url": "git+https://github.com/Talkdedsec1/tlk-sentinel.git" },
  "engines": { "node": ">=22.5" },
  "workspaces": [
    "packages/core",
    "packages/agent",
    "packages/web"
  ],
  "scripts": {
    "build": "tsc -b packages/core packages/agent packages/web",
    "agent": "node --enable-source-maps --disable-warning=ExperimentalWarning packages/agent/dist/index.js",
    "agent:dev": "tsx packages/agent/src/index.ts",
    "test": "node --disable-warning=ExperimentalWarning --test \"tests/*.test.mjs\"",
    "typecheck": "tsc -b packages/core packages/agent packages/web",
    "dist:public": "node scripts/build-public.mjs"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "@types/node": "^22.10.2"
  }
}
